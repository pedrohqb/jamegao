{
  "manifest_version": 3,
  "name": "Oficial falsa (teste)",
  "version": "1.0.0",
  "description": "Imita a extensão oficial para os testes de convivência.",
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
